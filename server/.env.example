# Application
APP_NAME=Scholar Portal
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URI=postgresql+psycopg://postgres:postgres@localhost:5432/scholar_db
DB_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0

# Security - replace before sharing or deploying
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Frontend and CORS
FRONTEND_URL=http://localhost:3000
ALLOWED_HOSTS=["localhost","127.0.0.1"]
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
CORS_ALLOW_CREDENTIALS=true

# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
OAUTH_REDIRECT_URL=http://localhost:8000/api/v1/auth/oauth/callback

# Supabase/storage (optional)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_STORAGE_BUCKET=posters

# Email (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
